# ── Vital Guardian — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in the values below.
#   cp .env.example .env
#
# docker-compose.yml automatically injects DATABASE_URL, OPENVINO_DEVICE, and
# AUDIO_ENABLED for the container, so you do NOT need to set those here unless
# you want to override the defaults for local (non-Docker) runs.
# ──────────────────────────────────────────────────────────────────────────────

# ── Inference mode ────────────────────────────────────────────────────────────
# KAGGLE  → MoViNet fall/seizure inference is routed to the Kaggle endpoint.
#           Lightweight; container has no local .keras models.
# LOCAL   → MoViNet models are loaded from fall_detection/ and seizure_detection/
#           on the host (mounted as read-only volumes).
INFERENCE_MODE=KAGGLE

# ── Kaggle inference endpoint (required when INFERENCE_MODE=KAGGLE) ───────────
# Paste the ngrok public URL printed by scripts/kaggle_api.py each time the
# Kaggle notebook starts.  After a notebook restart, update this value and run:
#   docker-compose restart app
KAGGLE_ENDPOINT=https://<your-ngrok-url>

# ── Google Gemini API key (required for cognitive core) ───────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional overrides (already set correctly by docker-compose.yml) ─────────
# Uncomment and change only if you need non-default values for bare-metal runs.
#
# DATABASE_URL=postgresql://postgres:1234@localhost:5432/postgres
# OPENVINO_DEVICE=intel:gpu         # bare-metal with Intel iGPU; docker uses intel:cpu
#
# Audio is controlled by TWO independent flags:
#
# MIC_ENABLED=true                  # open the real host microphone device
#                                   # set false in Docker (no audio hardware)
#
# AUDIO_ANALYTICS_ENABLED=true      # run YAMNet distress + Whisper keyword models
#                                   # stays true in Docker — models analyse audio
#                                   # extracted from pre-recorded video clips
#                                   # (whooping cough, asthma attack segments)
#                                   # via the queue stub, no mic device needed
